# Copy this file to .env for Docker Compose.

LAVEMILL_PORT=8080
LAVEMILL_DB_VIEWER_PORT=8082
LAVEMILL_TIME_ZONE=Europe/London
# Leave blank to use http://127.0.0.1 with LAVEMILL_PORT.
LAVEMILL_ORIGIN=

# Homelab shortcuts are optional. Use URLs reachable from household browsers.
LAVEMILL_SEERR_URL=
LAVEMILL_PLEX_URL=
LAVEMILL_KOMGA_URL=
LAVEMILL_FOUNDRY_URL=
LAVEMILL_BOOKSTACK_URL=

# Tautulli is optional. Set both values to enable Plex activity.
# Use the base URL without /home, for example http://192.168.178.38:8181.
LAVEMILL_TAUTULLI_URL=
LAVEMILL_TAUTULLI_API_KEY=

# Steam is optional. Set a Steam Web API key to enable playing activity.
LAVEMILL_STEAM_API_KEY=

# Google Calendar is optional. Set all three values to enable it.
LAVEMILL_GOOGLE_CLIENT_ID=
LAVEMILL_GOOGLE_CLIENT_SECRET=
LAVEMILL_GOOGLE_TOKEN_KEY=

# Outlook Calendar is optional. Set all three values to enable it.
LAVEMILL_OUTLOOK_CLIENT_ID=
LAVEMILL_OUTLOOK_CLIENT_SECRET=
LAVEMILL_OUTLOOK_TOKEN_KEY=
